<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b0f14" />
    <title>@ViewData["Title"] - Northstar</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/tradingbot.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">N</span><span>northstar<span class="brand-subtitle">TRADING DESK</span></span></a>
            <div class="nav-label">WORKSPACE</div>
            <nav class="desk-nav" aria-label="Main navigation">
                <a class="active" asp-controller="Home" asp-action="Index"><span>▦</span> Overview</a>
                <a href="#markets"><span>◫</span> Market watch</a>
                <a href="#paper-terminal"><span>⇄</span> Paper terminal</a>
                <a href="#positions"><span>▤</span> Positions</a>
                <a href="#activity"><span>◷</span> Order activity</a>
            </nav>
            <div class="sidebar-bottom">
                <div class="risk-status"><span class="status-dot"></span><div><strong>Risk controls active</strong><small>Demo guardrails enabled</small></div></div>
                <a class="privacy-link" asp-controller="Home" asp-action="Privacy">Privacy &amp; demo details</a>
                <div class="user-chip"><span class="avatar">AK</span><span><strong>Demo account</strong><small>Paper trading</small></span><span class="user-menu">···</span></div>
            </div>
        </aside>
        <main class="main-area" role="main">
            <header class="topbar">
                <div class="breadcrumb">Workspace <span>/</span> <strong>Overview</strong></div>
                <div class="topbar-right"><span class="market-state"><i></i> SIMULATED FEED</span><span class="top-divider"></span><span class="date-label" id="local-clock">--:--:-- IST</span><span class="mode-pill">PAPER MODE</span></div>
            </header>
            @RenderBody()
            <footer class="app-footer"><span>Northstar Trading Desk · Demo environment</span><span>Market prices and fills are simulated</span></footer>
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@10.0.0/dist/browser/signalr.min.js" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
